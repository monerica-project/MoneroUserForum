@{ ViewData["Title"] = "Awaiting approval"; }
<div class="panel form-narrow" style="margin: 30px auto 0; text-align:center;">
    <h1>Welcome — you're almost in</h1>
    <p class="muted">Your account was created and you're signed in. To keep spam off the forum, an admin approves new members before they can post.</p>
    <p class="muted">You can browse and read everything now; posting, chat, and messages unlock once you're approved.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Browse the forum</a>
</div>

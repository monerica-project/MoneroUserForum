@model MoneroUserForum.Web.Models.Account.RegisterViewModel
@{ ViewData["Title"] = "Register"; }

<div class="panel form-narrow" style="margin: 30px auto 0;">
    <h1>Create an account</h1>
    <p class="muted">No email required. New accounts are approved by an admin before they can post — this keeps out spam.</p>
    <form asp-action="Register" method="post" id="register-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Username"></label>
            <input asp-for="Username" autocomplete="username" autofocus />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
            <div class="hint">Optional. If set, you can reset your password by email. Left blank, there is no reset.</div>
        </div>
        <div class="form-group">
            <label asp-for="JoinNote"></label>
            <textarea asp-for="JoinNote" rows="3" placeholder="A quick note so the admin knows you're a real person — why you'd like to join."></textarea>
            <span asp-validation-for="JoinNote" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="CaptchaAnswer">Spam check — what is @ViewBag.Captcha?</label>
            <input asp-for="CaptchaAnswer" autocomplete="off" inputmode="numeric" style="max-width:120px;" />
            <span asp-validation-for="CaptchaAnswer" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Register</button>
    </form>
    <p class="muted" style="margin-top:14px;">Already have an account? <a asp-action="Login">Log in</a>.</p>
</div>

@model MoneroUserForum.Web.Models.Account.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; }
<div class="panel form-narrow" style="margin: 30px auto 0;">
    <h1>Forgot password</h1>
    @if (ViewBag.Sent == true)
    {
        <div class="alert alert-info">If that account exists and has an email set, a reset link has been sent. Accounts without an email can't be reset — contact an admin.</div>
    }
    else
    {
        <p class="muted">Password reset only works if you added an email to your account.</p>
        <form asp-action="ForgotPassword" method="post">
            <div class="form-group">
                <label asp-for="Username"></label>
                <input asp-for="Username" autofocus />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
        </form>
    }
</div>

@model MoneroUserForum.Web.Models.Account.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
<div class="panel form-narrow" style="margin: 30px auto 0;">
    <h1>Reset password</h1>
    <form asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" autocomplete="new-password" autofocus />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Reset password</button>
    </form>
</div>

@model List<MoneroUserForum.Web.Models.Messages.MessageItem>
@using MoneroUserForum.Web.Support
@if (Model.Count == 0)
{
    <p class="muted">No messages yet — say hello.</p>
}
else
{
    <div class="dm-list">
        @foreach (var m in Model)
        {
            <div class="dm-bubble @(m.FromMe ? "me" : "them")">
                <div class="dm-time">@TimeAgo(m.CreatedAtUtc)</div>
                @if (!string.IsNullOrEmpty(m.Envelope))
                {
                    @* Ciphertext only. e2ee-messages.js decrypts in-browser and fills textContent. *@
                    <div class="dm-text dm-enc" data-envelope="@m.Envelope">🔒 decrypting…</div>
                }
                else
                {
                    <div class="dm-text">@m.Body</div>
                    <div class="dm-time" style="opacity:.7;" title="This message was sent from a browser that could not encrypt, so it is stored unencrypted.">🔓 not encrypted</div>
                    @* Warn (never block) when a RECEIVED message contains a link. *@
                    @if (!m.FromMe && LinkHeuristics.HasLink(m.Body))
                    {
                        <div class="dm-link-warn">⚠ This message contains a link — double-check it before opening.</div>
                    }
                }
            </div>
        }
    </div>
}

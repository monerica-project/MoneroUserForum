@model List<MoneroUserForum.Web.Models.Messages.MessageItem>
@using MoneroUserForum.Web.Support
@if (Model.Count == 0)
{
    <p class="muted">No messages yet — say hello.</p>
}
else
{
    <div class="dm-list">
        @foreach (var m in Model)
        {
            <div class="dm-bubble @(m.FromMe ? "me" : "them")">
                <div class="dm-time">@TimeAgo(m.CreatedAtUtc)</div>
                @if (!string.IsNullOrEmpty(m.Envelope))
                {
                    <div class="dm-text muted">🔒 Message from the old browser encryption system (no longer supported).</div>
                }
                else if (m.Body.StartsWith(MoneroUserForum.Services.Pgp.PgpTools.MessageHeader, StringComparison.Ordinal))
                {
                    @* Ciphertext only; the reader decrypts it with their own PGP software. *@
                    <pre class="dm-text dm-pgp">@m.Body</pre>
                    <div class="dm-time" style="opacity:.7;">🔒 PGP encrypted — decrypt with your private key</div>
                }
                else
                {
                    <div class="dm-text">@m.Body</div>
                    <div class="dm-time" style="opacity:.7;" title="Sent before PGP encryption was required.">🔓 not encrypted (sent before PGP was required)</div>
                    @* Warn (never block) when a RECEIVED message contains a link. *@
                    @if (!m.FromMe && LinkHeuristics.HasLink(m.Body))
                    {
                        <div class="dm-link-warn">⚠ This message contains a link — double-check it before opening.</div>
                    }
                }
            </div>
        }
    </div>
}

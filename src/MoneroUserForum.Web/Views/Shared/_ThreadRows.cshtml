@model IReadOnlyList<ThreadListItem>

@if (Model.Count == 0)
{
    <p class="muted" style="padding:16px 0;">No threads yet. Be the first to start a discussion.</p>
}
else
{
    foreach (var t in Model)
    {
        <div class="thread-row">
            <div class="thread-row-main">
                <div class="thread-title">
                    @if (t.IsPinned)
                    {
                        <span class="chip" style="margin-right:6px;">Pinned</span>
                    }
                    <a asp-controller="Thread" asp-action="View" asp-route-slug="@t.Slug">@t.Title</a>
                </div>
                <div class="thread-meta">
                    <a class="chip chip-cat cat-@t.Category" asp-controller="Thread" asp-action="Category" asp-route-category="@t.Category">@Describe(t.Category)</a>
                    &nbsp;by @if (t.AuthorBanned)
                    {
                        <text>[banned]</text>
                    }
                    else
                    {
                        <a asp-controller="Profile" asp-action="View" asp-route-name="@t.AuthorName">@t.AuthorName</a>
                    } · started @TimeAgo(t.CreatedAtUtc)
                </div>
            </div>
            <div class="thread-row-stats">
                <div class="thread-meta"><b style="color:var(--fg)">@t.ReplyCount</b> repl@(t.ReplyCount == 1 ? "y" : "ies") · <b style="color:var(--fg)">@t.UniqueViews</b> view@(t.UniqueViews == 1 ? "" : "s")</div>
                <div class="thread-meta thread-lastby">
                    last by
                    @if (string.IsNullOrEmpty(t.LastPosterName))
                    {
                        <text>—</text>
                    }
                    else
                    {
                        <a asp-controller="Profile" asp-action="View" asp-route-name="@t.LastPosterName" class="lastby-link"><img class="avatar avatar-xs" src="@(t.LastPosterAvatarUrl ?? Url.Content("~/img/muf-mark.png"))" alt="" />@t.LastPosterName</a>
                    }
                    · @TimeAgo(t.LastPostAtUtc)
                </div>
                @{ var lastPage = Math.Max(1, (int)Math.Ceiling(t.PostCount / 20.0)); }
                <a class="btn btn-sm" style="margin-top:5px;" href="/thread/@t.Slug?page=@lastPage#post-@t.LastPostId">Last reply →</a>
            </div>
        </div>
    }
}

@model List<ChatMessageItem>
@if (Model.Count == 0)
{
    <p class="muted">No messages yet. Say hello 👋</p>
}
else
{
    foreach (var m in Model)
    {
        <div class="chat-msg">
            <span class="who">@m.AuthorName</span> <span class="when">@TimeAgo(m.CreatedAtUtc)</span>
            <div>@m.Body</div>
        </div>
    }
}

@model IReadOnlyList<ConversationSummary>
@{ ViewData["Title"] = "Messages"; }

<div class="dm-layout">
    <div class="dm-leftcol">
        @await Html.PartialAsync("_ConversationList", Model)
    </div>

    <section class="dm-threadcol">
        <div class="panel dm-empty">
            @if (Model.Count == 0)
            {
                <p class="muted" style="margin:0;">You have no messages yet. Start a conversation from a member's profile or with “New Chat”.</p>
            }
            else
            {
                <p class="muted" style="margin:0;">Select a conversation on the left to read it, or start a new one.</p>
            }
        </div>
        @await Component.InvokeAsync("Sponsors", new { side = true })
    </section>
</div>

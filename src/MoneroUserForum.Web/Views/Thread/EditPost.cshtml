@model EditPostViewModel
@{ ViewData["Title"] = "Edit post"; }
<div class="panel" style="max-width:720px;">
    <h1>Edit post</h1>
    <form asp-action="EditPost" asp-route-id="@Model.PostId" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <textarea asp-for="Body" rows="10" class="md-editor" required></textarea>
            <span asp-validation-for="Body" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a class="btn" href="/thread/@Model.ThreadSlug#post-@Model.PostId">Cancel</a>
    </form>
</div>

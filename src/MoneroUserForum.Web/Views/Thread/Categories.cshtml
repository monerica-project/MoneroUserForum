@model List<ForumCategory>
@{
    ViewData["Title"] = "Categories";
    ViewData["Description"] = "Browse Monero discussion categories on the Monero User Forum — Price Talk, Technical Help, and General Discussion.";
}
<h1>Categories</h1>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;">
    @foreach (var c in Model)
    {
        <a class="panel" style="display:block;margin:0;" asp-controller="Thread" asp-action="Category" asp-route-category="@c">
            <div class="chip chip-cat cat-@c" style="margin-bottom:8px;">@Describe(c)</div>
            <div class="muted" style="font-size:13px;">
                @switch (c)
                {
                    case ForumCategory.PriceTalk: <text>Markets, price, and trading talk.</text> break;
                    case ForumCategory.TechnicalHelp: <text>Wallets, nodes, and troubleshooting.</text> break;
                    default: <text>Everything else Monero.</text> break;
                }
            </div>
        </a>
    }
</div>

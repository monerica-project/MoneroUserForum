@model CreateThreadViewModel
@{ ViewData["Title"] = "New thread"; }
<div class="thread-layout">
<div class="thread-main">
<div class="panel">
    <h1>Start a new thread</h1>
    @if (User.Identity?.IsAuthenticated == true && !User.HasClaim("approved", "true") && !User.HasClaim("banned", "true"))
    {
        <p class="muted" style="border-left:3px solid var(--mono-orange,#f26822);padding:8px 12px;margin:0 0 14px;">
            ⏳ You can post now, but your thread stays hidden from other members until an admin approves your
            account. It goes live automatically once you're approved — so go ahead and share what you came to say.
        </p>
    }
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @if (ViewBag.ExistingSlug is string existingSlug)
        {
            <div class="alert alert-info">
                A thread with this title already exists:
                <a href="/thread/@existingSlug"><strong>@ViewBag.ExistingTitle</strong></a>
            </div>
        }
        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" autofocus />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Category"></label>
            <select asp-for="Category">
                @foreach (var c in Enum.GetValues<ForumCategory>().Where(x => x != ForumCategory.Unknown).OrderBy(x => Describe(x), StringComparer.OrdinalIgnoreCase))
                {
                    <option value="@c">@Describe(c)</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label asp-for="Body"></label>
            <textarea asp-for="Body" rows="10" class="md-editor" placeholder="Write your post… @@mention someone to notify them. Highlight text and click 🔗 to add a link."></textarea>
            <span asp-validation-for="Body" class="text-danger"></span>
            @await Html.PartialAsync("_FormattingHelp")
        </div>
        @if (ViewBag.CanPostImages is true)
        {
            <div class="form-group">
                <label class="dim" style="font-size:13px;">📷 Attach images (up to 4 · JPG/PNG/WEBP/GIF · 5 MB each)</label>
                <input type="file" name="images" accept="image/png,image/jpeg,image/webp,image/gif" multiple />
            </div>
        }
        else if (ViewBag.ImageUnlockUtc is DateTime unlock)
        {
            var days = (int)Math.Ceiling((unlock - DateTime.UtcNow).TotalDays);
            <p class="dim" style="font-size:12px;">📷 Image posting unlocks @(days <= 1 ? "in under a day" : $"in {days} days") (1 month after approval). <a href="/account/unlocks">See what unlocks when →</a></p>
        }
        <button type="submit" class="btn btn-primary">Post thread</button>
    </form>
</div>
</div>
<aside class="thread-side">
    @await Component.InvokeAsync("MoneroPrice")
    @await Component.InvokeAsync("Sponsors", new { side = true })
</aside>
</div>

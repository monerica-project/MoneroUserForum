@model ProfileEditViewModel
@{ ViewData["Title"] = "Edit profile"; }

<div class="panel" style="max-width:680px;">
    <h1>Edit profile</h1>
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label>Profile image</label>
            <div style="display:flex;align-items:center;gap:12px;">
                <img class="avatar avatar-lg" src="@(Model.CurrentAvatarUrl ?? Url.Content("https://cdn.monerouserforum.com/muf-mark.png"))" alt="" />
                <input type="file" name="avatar" accept="image/png,image/jpeg,image/webp,image/gif" />
            </div>
            <div class="hint">JPG/PNG/WEBP/GIF, under 3 MB. Approved members only.</div>
        </div>

        <div class="form-group">
            <label asp-for="Signature"></label>
            <textarea asp-for="Signature" rows="3" placeholder="Shown under your posts"></textarea>
        </div>
        <div class="form-group">
            <label asp-for="WebsiteUrl"></label>
            <input asp-for="WebsiteUrl" placeholder="https://" />
            <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="TwitterUrl"></label>
            <input asp-for="TwitterUrl" placeholder="https://x.com/you" />
        </div>
        <div class="form-group">
            <label asp-for="SimpleXAddress"></label>
            <input asp-for="SimpleXAddress" />
        </div>
        <div class="form-group">
            <label asp-for="TelegramHandle"></label>
            <input asp-for="TelegramHandle" placeholder="@@handle" />
        </div>
        <div class="form-group">
            <label asp-for="MonericaUrl"></label>
            <input asp-for="MonericaUrl" placeholder="https://monerica.com/site/your-listing" />
            <span asp-validation-for="MonericaUrl" class="text-danger"></span>
            <p class="hint" style="margin-top:4px;">If your project is listed on <a href="https://monerica.com" target="_blank" rel="noopener">monerica.com</a>, link your listing here.</p>
        </div>

        <h2 class="panel-title" style="margin-top:20px;">Your links</h2>
        <p class="hint" style="margin-top:-6px;">Up to three links — e.g. your personal site, a social profile, or anything else. Each needs an http/https URL to show as a link.</p>
        @for (var i = 1; i <= 3; i++)
        {
            var labelName = $"Link{i}Label";
            var urlName = $"Link{i}Url";
            var labelVal = (string?)ViewData.Eval(labelName);
            var urlVal = (string?)ViewData.Eval(urlName);
            <div class="form-group" style="display:flex;gap:8px;flex-wrap:wrap;">
                <input name="@labelName" value="@labelVal" maxlength="40" placeholder="Label (e.g. My site)" style="flex:1 1 160px;" />
                <input name="@urlName" value="@urlVal" maxlength="2048" placeholder="https://" style="flex:2 1 240px;" />
            </div>
        }

        <div class="form-group">
            <label asp-for="MoneroDonationAddress"></label>
            <input asp-for="MoneroDonationAddress" placeholder="4... or 8..." />
            <div class="hint">Shown on your profile with a tip QR code so others can send you XMR from their own wallet.</div>
        </div>
        <div class="form-group">
            <label asp-for="PgpPublicKey"></label>
            <textarea asp-for="PgpPublicKey" rows="6" placeholder="-----BEGIN PGP PUBLIC KEY BLOCK-----"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Save profile</button>
    </form>
</div>

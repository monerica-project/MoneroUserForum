@model ProfileViewModel
@{
    ViewData["Title"] = Model.DisplayName;
    ViewData["OgType"] = "profile";
    ViewData["Description"] = $"{Model.DisplayName} on the Monero User Forum — {Describe(Model.Reputation)}, {Model.PostCount} posts.";
}

<div class="panel">
    <div style="display:flex;gap:16px;align-items:flex-start;flex-wrap:wrap;">
        <img class="avatar avatar-lg" src="@(Model.AvatarUrl ?? Url.Content("https://cdn.monerouserforum.com/muf-mark.png"))" alt="" />
        <div style="flex:1 1 auto;min-width:0;">
            <h1 style="margin:0;">@Model.DisplayName
                @if (Model.IsBanned) { <span class="chip" style="color:#ff8a8a;border-color:rgba(255,82,82,.4);">banned</span> }
            </h1>
            <div class="thread-meta">
                <span class="rep">@Describe(Model.Reputation)</span> · <a href="#posts" title="See all posts by this member">@Model.PostCount posts</a> · joined @TimeAgo(Model.JoinedAtUtc)
                <br />
                <a asp-action="Thanks" asp-route-name="@Model.DisplayName" asp-route-type="received" title="See which posts were thanked">★ @Model.ThanksReceived thanks received</a>
                · <a asp-action="Thanks" asp-route-name="@Model.DisplayName" asp-route-type="given" title="See which posts this member thanked">☆ @Model.ThanksGiven given</a>
                <time datetime="@Model.JoinedAtUtc.ToString("yyyy-MM-ddTHH:mm:ss'Z'")" style="font-size:11px;opacity:.65;margin-left:6px;" title="Joined (UTC)">@Model.JoinedAtUtc.ToString("yyyy-MM-ddTHH:mm'Z'")</time>
            </div>
            @if (Model.IsSelf)
            {
                <div style="margin-top:10px;">
                    <a class="btn btn-sm" asp-action="Edit">Edit profile</a>
                    <a class="btn btn-sm" asp-controller="Account" asp-action="Settings">Account settings</a>
                </div>
            }
            else if ((User.Identity?.IsAuthenticated ?? false) && !Model.IsBanned)
            {
                <div style="margin-top:10px;">
                    <a class="btn btn-sm btn-primary" asp-controller="Messages" asp-action="New" asp-route-to="@Model.DisplayName">Message</a>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Signature))
    {
        <div class="post-sig" style="margin-top:14px;border-top:1px solid var(--border);padding-top:12px;">@Model.Signature</div>
    }
</div>

<div class="panel" id="posts">
    <h2 class="panel-title">Posts &amp; comments</h2>
    @if (Model.RecentPosts.Count == 0)
    {
        <p class="muted" style="margin:0;">No posts yet.</p>
    }
    else
    {
        <ul style="list-style:none;margin:0;padding:0;">
            @foreach (var post in Model.RecentPosts)
            {
                <li style="padding:10px 0;border-bottom:1px solid var(--border);">
                    <a href="/thread/@post.ThreadSlug#post-@post.PostId" style="font-weight:700;">@post.ThreadTitle</a>
                    <span class="chip" style="margin-left:6px;">@(post.IsOpeningPost ? "Thread" : "Reply")</span>
                    <span class="dim" style="font-size:11px;margin-left:6px;" title="@post.CreatedAtUtc.ToString("yyyy-MM-ddTHH:mm'Z'")">@TimeAgo(post.CreatedAtUtc)</span>
                    <div class="muted" style="font-size:13px;margin-top:3px;word-break:break-word;">@post.Snippet@(post.Snippet.Length >= 180 ? "…" : "")</div>
                </li>
            }
        </ul>
        @if (Model.TotalPages > 1)
        {
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:12px;">
                <span>@if (Model.Page > 1) { <a class="btn btn-sm" asp-action="View" asp-route-name="@Model.DisplayName" asp-route-page="@(Model.Page - 1)">← Newer</a> }</span>
                <span class="muted" style="font-size:12px;">Page @Model.Page of @Model.TotalPages</span>
                <span>@if (Model.Page < Model.TotalPages) { <a class="btn btn-sm" asp-action="View" asp-route-name="@Model.DisplayName" asp-route-page="@(Model.Page + 1)">Older →</a> }</span>
            </div>
        }
    }
</div>

@if (HasAnyLinks())
{
    <div class="panel">
        <h2 class="panel-title">Links &amp; contact</h2>
        <ul class="muted" style="margin:0;padding-left:18px;line-height:2;">
            @{ var wsafe = SafeHttpUrl(Model.WebsiteUrl); var tsafe = SafeHttpUrl(Model.TwitterUrl); }
            @if (wsafe != null) { <li>Website: <a href="@wsafe" target="_blank" rel="nofollow noopener">@Model.WebsiteUrl</a></li> }
            else if (!string.IsNullOrWhiteSpace(Model.WebsiteUrl)) { <li>Website: @Model.WebsiteUrl</li> }
            @if (tsafe != null) { <li>X / Twitter: <a href="@tsafe" target="_blank" rel="nofollow noopener">@Model.TwitterUrl</a></li> }
            else if (!string.IsNullOrWhiteSpace(Model.TwitterUrl)) { <li>X / Twitter: @Model.TwitterUrl</li> }
            @if (!string.IsNullOrWhiteSpace(Model.SimpleXAddress)) { <li>SimpleX: <span style="word-break:break-all;">@Model.SimpleXAddress</span></li> }
            @if (!string.IsNullOrWhiteSpace(Model.TelegramHandle)) { <li>Telegram: @Model.TelegramHandle</li> }
            @{ var msafe = SafeHttpUrl(Model.MonericaUrl); }
            @if (msafe != null) { <li>Monerica listing: <a href="@msafe" target="_blank" rel="nofollow noopener">@Model.MonericaUrl</a></li> }
            else if (!string.IsNullOrWhiteSpace(Model.MonericaUrl)) { <li>Monerica listing: @Model.MonericaUrl</li> }
            @foreach (var (label, url) in CustomLinks())
            {
                var safe = SafeHttpUrl(url);
                var text = string.IsNullOrWhiteSpace(label) ? url : label;
                if (safe != null) { <li><a href="@safe" target="_blank" rel="nofollow noopener ugc">@text</a></li> }
                else { <li>@text</li> }
            }
        </ul>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.MoneroDonationAddress))
{
    <div class="panel">
        <h2 class="panel-title">Tip @Model.DisplayName in Monero</h2>
        <div style="display:flex;gap:16px;align-items:flex-start;flex-wrap:wrap;">
            @if (!string.IsNullOrEmpty(Model.MoneroQrDataUri))
            {
                <img src="@Model.MoneroQrDataUri" alt="Monero tip QR code" width="150" height="150"
                     style="flex:0 0 auto;border-radius:6px;background:#fff;padding:6px;" />
            }
            <div style="flex:1 1 220px;min-width:0;">
                <div class="dim" style="font-size:12px;margin-bottom:4px;">Scan with a Monero wallet, or copy the address:</div>
                <code style="word-break:break-all;display:block;background:var(--bg);padding:8px 10px;border-radius:6px;border:1px solid var(--border);font-family:var(--mono);font-size:11px;line-height:1.35;">@Model.MoneroDonationAddress</code>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.PgpPublicKey))
{
    <div class="panel">
        <h2 class="panel-title">PGP public key</h2>
        <pre style="white-space:pre;overflow:auto;max-height:190px;background:var(--bg);padding:10px 12px;border-radius:6px;border:1px solid var(--border);font-family:var(--mono);font-size:10.5px;line-height:1.3;">@Model.PgpPublicKey</pre>
    </div>
}

@functions {
    IEnumerable<(string? Label, string? Url)> CustomLinks()
    {
        if (!string.IsNullOrWhiteSpace(Model.Link1Url) || !string.IsNullOrWhiteSpace(Model.Link1Label)) { yield return (Model.Link1Label, Model.Link1Url); }
        if (!string.IsNullOrWhiteSpace(Model.Link2Url) || !string.IsNullOrWhiteSpace(Model.Link2Label)) { yield return (Model.Link2Label, Model.Link2Url); }
        if (!string.IsNullOrWhiteSpace(Model.Link3Url) || !string.IsNullOrWhiteSpace(Model.Link3Label)) { yield return (Model.Link3Label, Model.Link3Url); }
    }

    bool HasAnyLinks() =>
        !string.IsNullOrWhiteSpace(Model.WebsiteUrl) || !string.IsNullOrWhiteSpace(Model.TwitterUrl)
        || !string.IsNullOrWhiteSpace(Model.SimpleXAddress) || !string.IsNullOrWhiteSpace(Model.TelegramHandle)
        || !string.IsNullOrWhiteSpace(Model.MonericaUrl)
        || CustomLinks().Any();
}

@model List<AdminMemberRow>
@{ ViewData["Title"] = "Approvals"; }
<h1>Pending approvals</h1>
<p class="muted">New accounts can read but can't post until approved. Reject removes spam accounts entirely.</p>

<div class="panel">
    @if (Model.Count == 0)
    {
        <p class="muted">Nothing waiting. 🎉</p>
    }
    else
    {
        foreach (var m in Model)
        {
            <div class="thread-row" style="align-items:flex-start;">
                <div style="flex:1 1 auto;min-width:0;">
                    <strong>@m.DisplayName</strong>
                    <div class="thread-meta">registered @TimeAgo(m.CreatedAtUtc)</div>
                    @if (!string.IsNullOrWhiteSpace(m.JoinNote))
                    {
                        <div class="muted" style="font-size:13px;margin-top:4px;border-left:3px solid var(--border-2);padding-left:8px;">“@m.JoinNote”</div>
                    }
                </div>
                <div style="display:flex;gap:8px;">
                    <form asp-action="Approve" asp-route-id="@m.Id" method="post">
                        <button type="submit" class="btn btn-primary btn-sm">Approve</button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@m.Id" method="post" data-confirm="Reject and delete this account?">
                        <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                    </form>
                </div>
            </div>
        }
    }
</div>

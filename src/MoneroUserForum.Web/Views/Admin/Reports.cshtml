@model List<AdminReportRow>
@{ ViewData["Title"] = "Reported posts"; }

<div style="display:flex;align-items:center;gap:12px;margin-bottom:6px;">
    <h1 style="margin:0;">Reported posts</h1>
    <span style="flex:1"></span>
    <a class="btn btn-sm" asp-controller="Admin" asp-action="Index">← Admin</a>
</div>
<p class="muted">Posts members flagged as spam or a problem. Open the post to act on it — censor, delete, or ban the author — then mark the report handled, or dismiss it if it's fine.</p>

@if (Model.Count == 0)
{
    <div class="panel"><p class="muted" style="margin:0;">Nothing in the queue. 🎉</p></div>
}
else
{
    <div class="panel">
        @foreach (var r in Model)
        {
            <div class="report-row">
                <div style="flex:1 1 auto;min-width:0;">
                    <div>
                        <a asp-controller="Thread" asp-action="View" asp-route-slug="@r.ThreadSlug"><strong>@r.ThreadTitle</strong></a>
                        @if (r.PostIsCensored) { <span class="chip" style="color:#ff8a8a;border-color:rgba(255,82,82,.4);">censored</span> }
                        @if (r.PostIsDeleted) { <span class="chip">deleted</span> }
                        @if (r.ReportCountForPost > 1) { <span class="chip chip-cat">@r.ReportCountForPost reports</span> }
                    </div>
                    <div class="thread-meta" style="margin-top:2px;">
                        post by <strong>@(r.PostAuthorBanned ? "[banned] " : "")@r.PostAuthor</strong>
                        · reported by @r.ReporterName · @TimeAgo(r.CreatedAtUtc)
                    </div>
                    @if (!string.IsNullOrWhiteSpace(r.Reason))
                    {
                        <div class="report-reason-shown">Reason: “@r.Reason”</div>
                    }
                    <div class="report-excerpt">@r.PostExcerpt</div>
                </div>
                <div class="report-actions">
                    <a class="btn btn-sm" href="/thread/@r.ThreadSlug#post-@r.PostId">Open post</a>
                    <form asp-controller="Admin" asp-action="ResolveReport" asp-route-id="@r.Id" method="post" style="display:inline">
                        <button type="submit" class="btn btn-sm btn-primary" title="You've acted on it">Mark handled</button>
                    </form>
                    <form asp-controller="Admin" asp-action="DismissReport" asp-route-id="@r.Id" method="post" style="display:inline"
                          data-confirm="Dismiss this report as not a problem?">
                        <button type="submit" class="btn btn-sm">Dismiss</button>
                    </form>
                </div>
            </div>
        }
    </div>
}

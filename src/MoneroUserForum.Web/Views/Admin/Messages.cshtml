@model List<MoneroUserForum.Data.Entities.ContactMessage>
@{ ViewData["Title"] = "Contact inbox"; }

<h1>Contact inbox</h1>
<p class="muted"><a asp-action="Index">← Admin</a> · Messages sent through the public <a asp-controller="Contact" asp-action="Index">contact page</a>.</p>

@if (Model.Count == 0)
{
    <div class="panel"><p class="muted" style="margin:0;">No messages yet.</p></div>
}
else
{
    @foreach (var m in Model)
    {
        <div class="panel" style="@(m.IsHandled ? "opacity:.6;" : "")">
            <div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;">
                <strong>@(string.IsNullOrEmpty(m.FromName) ? "(anonymous)" : m.FromName)</strong>
                @if (!string.IsNullOrEmpty(m.FromEmail))
                {
                    <a href="mailto:@m.FromEmail" class="muted">@m.FromEmail</a>
                }
                <span class="dim" style="margin-left:auto;">@m.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span>
                @if (m.IsHandled)
                {
                    <span class="badge">handled</span>
                }
            </div>
            <p style="white-space:pre-wrap;word-break:break-word;margin:10px 0 12px;">@m.Message</p>
            <div style="display:flex;gap:8px;">
                <form asp-action="ToggleContactHandled" asp-route-id="@m.Id" method="post">
                    <button type="submit" class="btn btn-sm">@(m.IsHandled ? "Mark unhandled" : "Mark handled")</button>
                </form>
                <form asp-action="DeleteContact" asp-route-id="@m.Id" method="post" data-confirm="Delete this message?">
                    <button type="submit" class="btn btn-sm">Delete</button>
                </form>
            </div>
        </div>
    }
}

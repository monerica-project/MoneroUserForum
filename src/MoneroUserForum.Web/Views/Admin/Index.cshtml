@model AdminDashboardViewModel
@{ ViewData["Title"] = "Admin"; }
<h1>Admin</h1>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-bottom:18px;">
    @{ var hasPending = Model.PendingCount > 0; }
    <a class="panel" style="margin:0;text-align:center;@(hasPending ? "border:2px solid #ff4d4d;background:rgba(255,60,60,.16);box-shadow:0 0 0 3px rgba(255,77,77,.35);" : "opacity:.75;")" asp-action="Approvals">
        <div style="font-size:30px;font-weight:800;color:@(hasPending ? "#ff5c5c" : "var(--muted,#8a8f98)");">@Model.PendingCount</div>
        <div class="muted">Pending approval</div>
        @if (hasPending)
        {
            <div style="color:#ff5c5c;font-weight:800;font-size:12px;margin-top:4px;text-transform:uppercase;letter-spacing:.03em;">⚠ @Model.PendingCount to review →</div>
        }
        else
        {
            <div class="muted" style="font-size:12px;margin-top:4px;">all clear</div>
        }
    </a>
    <a class="panel" style="margin:0;text-align:center;" asp-action="Reports">
        <div style="font-size:30px;font-weight:800;color:@(Model.ReportsPending > 0 ? "#ff8a8a" : "inherit");">@Model.ReportsPending</div>
        <div class="muted">Reported posts</div>
    </a>
    <a class="panel" style="margin:0;text-align:center;" asp-action="Messages">
        <div style="font-size:30px;font-weight:800;color:@(Model.ContactUnread > 0 ? "var(--mono-orange)" : "inherit");">@Model.ContactUnread</div>
        <div class="muted">Contact inbox</div>
    </a>
    <a class="panel" style="margin:0;text-align:center;" asp-action="Members">
        <div style="font-size:30px;font-weight:800;">@Model.MemberCount</div>
        <div class="muted">Members</div>
    </a>
    <div class="panel" style="margin:0;text-align:center;">
        <div style="font-size:30px;font-weight:800;">@Model.BannedCount</div>
        <div class="muted">Banned</div>
    </div>
    <div class="panel" style="margin:0;text-align:center;">
        <div style="font-size:30px;font-weight:800;">@Model.ThreadCount</div>
        <div class="muted">Threads</div>
    </div>
    <div class="panel" style="margin:0;text-align:center;">
        <div style="font-size:30px;font-weight:800;">@Model.PostCount</div>
        <div class="muted">Posts</div>
    </div>
</div>
<div class="panel">
    <a class="btn @(hasPending ? "" : "btn-primary")" style="@(hasPending ? "background:#ff4d4d;border-color:#ff4d4d;color:#fff;font-weight:700;" : "")" asp-action="Approvals">@(hasPending ? $"⚠ Review {Model.PendingCount} pending" : "Review pending (0)")</a>
    <a class="btn" asp-action="Reports">Reported posts (@Model.ReportsPending)</a>
    <a class="btn" asp-action="Messages">Contact inbox (@Model.ContactUnread)</a>
    <a class="btn" asp-action="Members">Manage members</a>
    <a class="btn" asp-action="Analytics">📈 Analytics</a>
</div>
